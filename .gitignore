# Local MCP client config. It references developer-machine commands and
# ${GLAMA_API_KEY}. Never publish it from a public site repository, and never
# inline a real key into it.
.mcp.json

# Environment / credentials — never commit
.env
.env.*
*.pem
*.key
.git-credentials

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Python cache from the tools/ scripts
__pycache__/
*.pyc
